#!/bin/bash
# flat_check — модульная версия FLAT/FCS health check + log collector + agent.
#
# Это НЕ третий монолит: реализация той же логики, что в flat_check.sh
# (health, v3.8.10) и flat_check_2.sh (health + log collector, v3.11.10),
# но разложенная по трём файлам в lib/ вместо одного файла на 3-9 тысяч
# строк. Интерфейс командной строки не менялся ни на один флаг (см.
# lib/core.sh, раздел 09_argv) — то, что раньше требовало flat_check.sh
# ИЛИ flat_check_2.sh, здесь делает один и тот же исполняемый файл:
# lib/core.sh грузится всегда, lib/logging.sh и lib/agent.sh подключаются
# только когда реально нужны (по флагам), а не «на всякий случай».
#
# Подробности слоёв, порядка подключения и почему именно так — см.
# ARCHITECTURE.md рядом с этим файлом.
#
# Использование: см. `./flat_check -h` (или ARCHITECTURE.md/README.md).

set -uo pipefail

SCRIPT_VERSION="1.0.0"

# SCRIPT_DIR/SCRIPT_NAME обязаны быть вычислены ЗДЕСЬ, в самой точке входа —
# не в lib/core.sh, потому что там ${BASH_SOURCE[0]} указывал бы на путь
# lib-файла, а не на flat_check. lib/core.sh уважает уже выставленные
# значения (": ${SCRIPT_DIR:=...}") и не перезаписывает их.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
[[ -z "$SCRIPT_DIR" ]] && SCRIPT_DIR="$(pwd)"
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

LIB_DIR="$SCRIPT_DIR/lib"

if [[ ! -f "$LIB_DIR/core.sh" ]]; then
    echo "[FAIL] lib/core.sh не найден рядом с $SCRIPT_NAME (ожидался $LIB_DIR/core.sh) — повреждённая установка?" >&2
    exit 1
fi

# --- core.sh: грузится всегда ---
# shellcheck disable=SC1091
source "$LIB_DIR/core.sh"

# --- Разбор флагов (сам по себе НИЧЕГО не запускает и не подключает) ---
parse_args "$@"

# --- Опциональные слои — по уже разобранным флагам, ДО диспетчера.
#
# ЛЮБОЙ --selftest (simple тоже, не только extended) и --dev подключают ОБА
# опциональных слоя: self-test — это проверка целостности всей ПОСТАВКИ, а не
# только режима, с которым его запустили. lib/core.sh (раздел 11_selftest)
# проверяет agent-функции (build_health_json/push_health_json/
# _json_collect_infra) уже на уровне "simple", а extended дополнительно
# гоняет проверки lib/logging.sh (парсеры времени, resource-gate, seek+chunk
# extract) — см. историю: обе ветки унаследованы из версий, где всё было
# одним файлом и эти функции существовали всегда.
#
# -i (мастер) тоже подключает оба слоя заранее: сам мастер решает уже ПОСЛЕ
# старта, в какой режим идти (health / -log / selftest) — если бы agent.sh/
# logging.sh подключались по флагам ДО входа в мастер, третий пункт меню
# мастера (самотест) остался бы без build_health_json, а второй (сбор логов)
# — без lib/logging.sh.
#
# --list-targets тоже требует lib/logging.sh даже без -log: dispatch_main
# (lib/core.sh, раздел 09_argv) вызывает list_log_targets() на основании
# LIST_TARGETS в одиночку, до какой-либо проверки MODE_LOG (найдено при
# код-ревью фазы 5 — `./flat_check --list-targets` без `-log` падал
# "command not found").
NEED_LOGGING=0
NEED_AGENT=0
[[ $MODE_LOG -eq 1 || $MODE_INTERACTIVE -eq 1 || $LIST_TARGETS -eq 1 ]] && NEED_LOGGING=1
[[ -n "${SELFTEST_MODE:-}" || $MODE_DEV -eq 1 ]] && NEED_LOGGING=1
[[ $OUTPUT_JSON -eq 1 || $DO_PUSH -eq 1 || -n "${CONFIG_FILE:-}" || $MODE_INTERACTIVE -eq 1 ]] && NEED_AGENT=1
[[ -n "${SELFTEST_MODE:-}" || $MODE_DEV -eq 1 ]] && NEED_AGENT=1

if [[ $NEED_LOGGING -eq 1 ]]; then
    if [[ -f "$LIB_DIR/logging.sh" ]]; then
        # shellcheck disable=SC1091
        source "$LIB_DIR/logging.sh"
    else
        echo "[FAIL] запрошен режим сборщика логов/мастера/самотеста (-i/-log/--dev/--selftest/--list-targets), но lib/logging.sh отсутствует в этой сборке" >&2
        exit 1
    fi
fi
if [[ $NEED_AGENT -eq 1 ]]; then
    if [[ -f "$LIB_DIR/agent.sh" ]]; then
        # shellcheck disable=SC1091
        source "$LIB_DIR/agent.sh"
    else
        echo "[FAIL] запрошен JSON/push agent/мастер/самотест (--json/--push/--config/--dev/--selftest/-i), но lib/agent.sh отсутствует в этой сборке" >&2
        exit 1
    fi
fi

dispatch_main "$@"
