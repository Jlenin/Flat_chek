#!/bin/bash
# flat_check — модульная версия FLAT/FCS health check + log collector + agent.
#
# Это НЕ третий монолит: реализация той же логики, что в flat_check.sh
# (health, v3.8.10) и flat_check_2.sh (health + log collector, v3.11.10),
# но разложенная по независимым модулям в lib/ вместо одного файла на
# 3-9 тысяч строк. Интерфейс командной строки не менялся ни на один флаг
# (см. lib/core/09_argv.sh) — то, что раньше требовало flat_check.sh ИЛИ
# flat_check_2.sh, здесь делает один и тот же исполняемый файл: core
# грузится всегда, lib/logging и lib/agent подключаются только когда
# реально нужны (по флагам), а не «на всякий случай».
#
# Подробности слоёв, порядка подключения и почему именно так — см.
# ARCHITECTURE.md рядом с этим файлом.
#
# Использование: см. `./flat_check -h` (или ARCHITECTURE.md/README.md).

set -uo pipefail

SCRIPT_VERSION="1.0.0"

# SCRIPT_DIR/SCRIPT_NAME обязаны быть вычислены ЗДЕСЬ, в самой точке входа —
# не в lib/core/00_globals.sh, потому что там ${BASH_SOURCE[0]} указывал бы
# на путь lib-файла, а не на flat_check. lib/core/00_globals.sh уважает уже
# выставленные значения (": ${SCRIPT_DIR:=...}") и не перезаписывает их.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
[[ -z "$SCRIPT_DIR" ]] && SCRIPT_DIR="$(pwd)"
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

LIB_DIR="$SCRIPT_DIR/lib"

if [[ ! -d "$LIB_DIR/core" ]]; then
    echo "[FAIL] lib/core не найден рядом с $SCRIPT_NAME (ожидался $LIB_DIR/core) — повреждённая установка?" >&2
    exit 1
fi

# Пустой glob не должен подставляться буквально (lib/agent, lib/logging
# в фазе 1 ещё не существуют — появятся в фазах 2-3).
shopt -s nullglob

# --- Core: грузится всегда, в этом порядке (числовой префикс = порядок) ---
for f in "$LIB_DIR"/core/*.sh; do
    # shellcheck disable=SC1090
    source "$f"
done

# --- Разбор флагов (сам по себе НИЧЕГО не запускает и не подключает) ---
parse_args "$@"

# --- Опциональные слои — по уже разобранным флагам, ДО диспетчера.
#
# ЛЮБОЙ --selftest (simple тоже, не только extended) и --dev подключают ОБА
# опциональных слоя: self-test — это проверка целостности всей ПОСТАВКИ, а не
# только режима, с которым его запустили. lib/core/11_selftest.sh проверяет
# agent-функции (build_health_json/push_health_json/_json_collect_infra) уже
# на уровне "simple", а extended дополнительно гоняет проверки lib/logging
# (парсеры времени, resource-gate, seek+chunk extract) — см. историю: обе
# ветки унаследованы из версий, где всё было одним файлом и эти функции
# существовали всегда.
#
# -i (мастер) тоже подключает оба слоя заранее: сам мастер решает уже ПОСЛЕ
# старта, в какой режим идти (health / -log / selftest) — если бы agent/
# logging подключались по флагам ДО входа в мастер, третий пункт меню
# мастера (самотест) остался бы без build_health_json, а второй (сбор логов)
# — без lib/logging.
#
# --list-targets тоже требует lib/logging даже без -log: dispatch_main
# (lib/core/09_argv.sh) вызывает list_log_targets() на основании LIST_TARGETS
# в одиночку, до какой-либо проверки MODE_LOG (найдено при код-ревью фазы 5 —
# `./flat_check --list-targets` без `-log` падал "command not found").
NEED_LOGGING=0
NEED_AGENT=0
[[ $MODE_LOG -eq 1 || $MODE_INTERACTIVE -eq 1 || $LIST_TARGETS -eq 1 ]] && NEED_LOGGING=1
[[ -n "${SELFTEST_MODE:-}" || $MODE_DEV -eq 1 ]] && NEED_LOGGING=1
[[ $OUTPUT_JSON -eq 1 || $DO_PUSH -eq 1 || -n "${CONFIG_FILE:-}" || $MODE_INTERACTIVE -eq 1 ]] && NEED_AGENT=1
[[ -n "${SELFTEST_MODE:-}" || $MODE_DEV -eq 1 ]] && NEED_AGENT=1

if [[ $NEED_LOGGING -eq 1 ]]; then
    if [[ -d "$LIB_DIR/logging" ]]; then
        for f in "$LIB_DIR"/logging/*.sh; do source "$f"; done
    else
        echo "[FAIL] запрошен режим сборщика логов/мастера/самотеста (-i/-log/--dev/--selftest), но lib/logging отсутствует в этой сборке" >&2
        exit 1
    fi
fi
if [[ $NEED_AGENT -eq 1 ]]; then
    if [[ -d "$LIB_DIR/agent" ]]; then
        for f in "$LIB_DIR"/agent/*.sh; do source "$f"; done
    else
        echo "[FAIL] запрошен JSON/push agent/мастер/самотест (--json/--push/--config/--dev/--selftest/-i), но lib/agent отсутствует в этой сборке" >&2
        exit 1
    fi
fi

dispatch_main "$@"
