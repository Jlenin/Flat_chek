[Unit]
Description=flat_check_agent — health/metrics daemon (full/services/metrics layers, see agent/README.md)

Wants=network-online.target
After=network-online.target
Wants=nss-lookup.target
After=nss-lookup.target

[Service]
# Долгоживущий процесс: сам планирует full/services/metrics внутренними
# таймерами (см. FULL_INTERVAL/SERVICES_INTERVAL/METRICS_INTERVAL в
# flat_check_agent.conf) — никакого cron/timer рядом не нужно.
Type=simple
User=flat-service
Group=flat-service

LimitCORE=infinity
LimitNOFILE=65536

# stdout — поток JSON (по одному объекту на каждый push каждого слоя),
# stderr — info/warn/fail; оба идут в journalctl -u flat-check по умолчанию.
# Явные файлы логов — только если в организации принято писать логи в
# файл, а не в journal.
SyslogIdentifier=flat-check

WorkingDirectory=/opt/flat/flat-check
ExecStart=/opt/flat/flat-check/flat_check_agent.sh

# SIGTERM — демон сам ловит его (trap) и завершает цикл после текущего тика,
# не обрывая push на середине; TimeoutStopSec — на случай, если тик full
# (самый долгий слой) как раз идёт в момент останова.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
