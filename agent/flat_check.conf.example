# /etc/flat/flat_check.conf
# Конфиг агента flat_check на НОДЕ продукта (как Zabbix active).
# Установщик копирует этот файл, если целевого конфига ещё нет.

# ---------------------------------------------------------------------------
# Куда слать снимок (Partner ingest). Несколько URL — через запятую или пробел.
# Поддерживаются http:// и https://
# Пусто = только локальный --json (без сети).
# ---------------------------------------------------------------------------
PUSH_URLS="https://partner.example.local/api/v1/health/ingest"

# Один URL (алиас; используется, если PUSH_URLS пуст):
# PUSH_URL="https://partner.example.local/api/v1/health/ingest"

# ---------------------------------------------------------------------------
# Токен стенда. Backend должен принимать тот же заголовок (см. backend-token).
# По умолчанию: Authorization: Bearer <token>
# ---------------------------------------------------------------------------
PUSH_TOKEN="CHANGE_ME"

# Разные токены на URL (порядок как в PUSH_URLS), опционально:
# PUSH_TOKENS="token-for-url1,token-for-url2"

# Заголовок авторизации (префикс до токена):
# PUSH_AUTH_HEADER="Authorization: Bearer"
# PUSH_AUTH_HEADER="X-Api-Key"

# ---------------------------------------------------------------------------
# Идентификация хоста в UI / инвентаре стенда (обязательные поля JSON).
# ---------------------------------------------------------------------------
HOST_ID="ss-n1"
# HOST_IP="10.0.1.5"          # иначе hostname -I / маршрут
SERVICE_NAME="fss-backend"    # CI/CD-имя: fss-backend, fps-backend, …

# ---------------------------------------------------------------------------
# Что проверять на ЭТОЙ машине.
# Пусто = авто: установленные пакеты из PKG_PRODUCT.
# ---------------------------------------------------------------------------
PACKAGES=""
# PRODUCT="SoftSwitch"
# PACKAGES="fss-server,fss-srclient"

# ---------------------------------------------------------------------------
# Таймауты / ретраи push
# ---------------------------------------------------------------------------
PUSH_CONNECT_TIMEOUT=5
PUSH_MAX_TIME=30
PUSH_RETRIES=2

# Параллельные воркеры проверки пакетов (как -j / --jobs)
# JOBS=4
