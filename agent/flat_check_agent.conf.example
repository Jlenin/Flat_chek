# flat_check_agent.conf — эталонный конфиг для flat_check_agent.sh
#
# Кладётся РЯДОМ со скриптом (по умолчанию flat_check_agent.sh ищет файл
# "flat_check_agent.conf" в своём же каталоге — переопределяется переменной
# окружения FLAT_AGENT_CONF, если нужен другой путь). Приоритет значений:
# переменные окружения > этот файл > встроенные дефолты. Отсутствие файла —
# не ошибка, скрипт просто работает на env/дефолтах.
#
# Этот файл — одновременно и пример, и рабочий эталон: PUSH_URLS ниже
# указывает на 127.0.0.1, поэтому конфиг можно использовать как есть для
# локальной проверки (запустить у себя тестовый приёмник на этом порту —
# см. agent/ingest-request.example.http) — никуда во внешнюю сеть он не
# уйдёт. Перед боевым использованием впишите свой реальный PUSH_URLS и
# PUSH_TOKEN.
#
# Скопируйте этот файл в flat_check_agent.conf и заполните под свой стенд:
#   cp flat_check_agent.conf.example flat_check_agent.conf

# Куда слать снимок (http/https). Несколько URL — через запятую или пробел.
# Пусто = только stdout, без сети (JSON всё равно печатается всегда).
PUSH_URLS="http://127.0.0.1:8080/api/v1/health/ingest"
# PUSH_URL="https://..."   # алиас, если PUSH_URLS пуст

# Токен стенда (по умолчанию уходит как: Authorization: Bearer <token>).
# Перед боевым использованием замените на настоящий токен приёмника.
PUSH_TOKEN="REPLACE_ME"
# PUSH_TOKENS="token1,token2"          # по одному на каждый URL
# PUSH_AUTH_HEADER="Authorization: Bearer"
# PUSH_AUTH_HEADER="X-Api-Key"

# Идентификация ноды в полях JSON (host_id/host_ip/service_name)
HOST_ID="n1"
SERVICE_NAME="REPLACE_ME"
# см. service_names.md    
# HOST_IP="10.0.1.5"          
# иначе определяется автоматически

# Что включать в JSON (пусто = все установленные продукты/пакеты)
PACKAGES=""
# PRODUCT="SoftSwitch"
# PACKAGES="fss-server,fss-srclient"

# Таймауты push
PUSH_CONNECT_TIMEOUT=5
PUSH_MAX_TIME=30
PUSH_RETRIES=2

# 1 = не проверять TLS-сертификат при https push (curl -k).
# Нужно, если у приёмника (Partner) самоподписанный сертификат — иначе
# push будет падать с "FAIL (last http=000)" при видимо верном URL.
# Включено по умолчанию в этом эталонном конфиге: PUSH_URLS выше — plain
# http на 127.0.0.1, для него флаг не имеет эффекта (TLS тут просто нет),
# так что держать его всегда включённым безопасно и удобно — при переходе
# на боевой https-приёмник с валидным сертификатом можно смело отключить.
PUSH_INSECURE=1

# Три слоя демона, каждый на своём интервале (секунды) — см. agent/README.md.
# full: полное обнаружение установленных пакетов (медленное) + push.
# services: статусы (systemd/process/ports/api) по уже известным пакетам + push.
# metrics: CPU/RAM/сеть напрямую из /proc, без повторного поиска пакетов + push.
# Дефолты ниже — закомментированы, раскомментируйте только если нужно другое.
# FULL_INTERVAL=3600
# SERVICES_INTERVAL=60
# METRICS_INTERVAL=5

# Путь к файлу кеша между слоями (по умолчанию — рядом со скриптом).
# CACHE_FILE="/opt/flat/flat_check_agent.cache"

# Файловый лог демона (info/warn/fail — то же, что в stderr, но построчно с
# таймстампом, тот же формат, что у flat_check.sh/flat_check_2.sh). Каталог
# создаётся сам при старте (mkdir -p); нет прав/каталог не создать — тихо
# работает без файла, только на stderr. Пусто ("") — файловый лог явно
# отключить. См. agent/flat-check.logrotate.example — сам лог не ротируется,
# демон долгоживущий, в отличие от разовых flat_check.sh/flat_check_2.sh.
# LOG_FILE="/var/log/flat/flat-check/flat_check_agent.log"    # дефолт, можно не указывать
