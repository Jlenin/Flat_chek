# flat_check_agent.sh — права доступа: установка от root, работа обычным сервисом
# ===============================================================================
#
# Этот файл — СПРАВКА, а не sudoers-конфиг: в /etc/sudoers.d его класть не
# нужно, правил sudo в нём нет. Агенту sudo не нужен ни для одной проверки.
#
# Модель:
#   1. Установка — один раз от root (sudo): пакет flat-check или шаги ниже.
#   2. Работа — systemd-сервис flat-check.service от обычного пользователя
#      flat-service:flat-group (User=/Group= в agent/flat-check.service.example).
#      Без sudo, без root, без дополнительных capabilities.
#
# Проверено (Ubuntu 24.04): установка по шагам ниже от root, затем запуск
# агента от flat-service через runuser — кеш, лог и push работают, ошибок
# прав нет. Сам systemd-юнит в песочнице не запускался (systemd там не
# работает).
#
#
# 1. УСТАНОВКА (от root, один раз)
# --------------------------------
# Пакет flat-check делает шаги «каталог агента» сам (postinst в .gitlab-ci.yml:
# chown -R на /opt/flat/flat-check, chmod 640 на конфиг). Каталог лога пакет
# пока НЕ создаёт — этот шаг нужен и при установке пакетом.
#
#   # Пользователь и группа сервиса (если их ещё нет на хосте)
#   getent group flat-group >/dev/null || groupadd --system flat-group
#   getent passwd flat-service >/dev/null || useradd --system -g flat-group \
#       -d /opt/flat/flat-check -M -s /usr/sbin/nologin flat-service
#
#   # Каталог агента. Писать сервис будет только в cache/ (создаёт его сам).
#   install -d -m 0755 /opt/flat/flat-check
#   cp flat_check_agent.sh /opt/flat/flat-check/
#   cp flat_check_agent.conf.example /opt/flat/flat-check/flat_check_agent.conf
#   chown -R flat-service:flat-group /opt/flat/flat-check
#   chmod 0755 /opt/flat/flat-check/flat_check_agent.sh
#   chmod 0640 /opt/flat/flat-check/flat_check_agent.conf   # в конфиге PUSH_TOKEN
#
#   # Каталог файлового лога (LOG_FILE). Без этого шага сервис не может
#   # создать /var/log/flat/flat-check и тихо работает без файла, только
#   # stderr (journalctl -u flat-check).
#   install -d -m 0755 /var/log/flat
#   install -d -m 0755 -o flat-service -g flat-group /var/log/flat/flat-check
#   # Именно 0755, не 0775: logrotate (работает от root) отказывается
#   # ротировать файл в каталоге, доступном на запись группе, отличной от
#   # root ("parent directory has insecure permissions").
#
#   # Юнит и ротация лога
#   cp flat-check.service.example /etc/systemd/system/flat-check.service
#   cp flat-check.logrotate.example /etc/logrotate.d/flat-check
#   systemctl daemon-reload
#   systemctl enable --now flat-check.service
#
#
# 2. РАБОТА (обычный сервис, без sudo)
# ------------------------------------
# Пишет агент только в два места:
#   /opt/flat/flat-check/cache/   — кеш и last_sent.json (создаёт сам)
#   /var/log/flat/flat-check/     — LOG_FILE (каталог создаётся при установке)
# Читает свой конфиг /opt/flat/flat-check/flat_check_agent.conf (0640).
#
# Всё остальное — только чтение, root для этого не нужен:
#   - dpkg-query/dpkg -s, rpm -q/-qa/-qR, pacman -Q — база пакетов
#   - systemctl show / is-active — состояние юнитов (D-Bus, только чтение)
#   - ss -lntu или netstat -lntu — слушающие порты (без -p, имена процессов
#     не нужны)
#   - pgrep, /proc/<pid>/stat, status, comm, cmdline — процессы
#   - /proc/stat, /proc/meminfo, /proc/net/dev, /proc/uptime,
#     /sys/class/net, df -P — CPU, память, сеть, диски
#   - curl — локальные health-API и push на PUSH_URLS
#   - openssl x509 — сертификаты в /etc/nginx/ssl, /opt/flat/cert,
#     /etc/ssl/certs/flat*.pem (нужно право на чтение файла; обычно 0644)
#   - проверка существования /opt/flat/<pkg>, /var/log/flat/<pkg>,
#     /etc/nginx/sites-*, /etc/logrotate.d — нужен только проход по каталогам
#
# Проверить, что сервис работает не от root:
#   systemctl show flat-check -p User -p Group
#   ps -o user=,group=,args= -p "$(systemctl show flat-check -p MainPID --value)"
#   ls -l /opt/flat/flat-check/cache /var/log/flat/flat-check   # владелец flat-service
#
# Запустить вручную (проверить конфиг) — тоже от имени сервиса, не от root.
# runuser работает и с оболочкой nologin; JSON печатается в терминал:
#   runuser -u flat-service -- /opt/flat/flat-check/flat_check_agent.sh
#
#
# 3. ЧТО БЕЗ ROOT ВИДНО ХУЖЕ (осознанные компромиссы, без ошибок и падений)
# ------------------------------------------------------------------------
# а) configs[].status для service_name="sudoers" (/etc/sudoers.d/<pkg>).
#    На Debian/Ubuntu каталог /etc/sudoers.d обычно 0750 root:root: без права
#    прохода проверка «есть ли файл» всегда отвечает «нет», и поле всегда
#    "missing", даже если файл есть. Если поле нужно — самый узкий вариант:
#
#      setfacl -m u:flat-service:x /etc/sudoers.d    # пакет acl
#
#    Это даёт только проход по каталогу: проверить файл по ИМЕНИ. Листинг
#    каталога и чтение файлов по-прежнему запрещены (проверено).
#      Проверить:  getfacl /etc/sudoers.d
#      Откатить:   setfacl -x u:flat-service /etc/sudoers.d
#    Шаг НЕОБЯЗАТЕЛЕН: деградация до "missing" безопасна.
#
# б) /proc смонтирован с hidepid=2: чужие процессы не видны, process.status
#    покажет "not running". Если нужно — добавить flat-service в группу,
#    указанную в опции gid= монтирования /proc.
#
# в) Сертификат без права на чтение: файл попадёт в certificates[] с
#    "days_left":0 и пустым subject — это не реальный срок. Сертификаты
#    (не ключи) обычно 0644 и читаются.
#
#
# 4. ЧЕГО ДЕЛАТЬ НЕ НУЖНО
# -----------------------
#   - Не давать flat-service sudo (тем более NOPASSWD:ALL) и не класть этот
#     файл в /etc/sudoers.d — ни одной проверке это не нужно.
#   - Не убирать User=/Group= из юнита и не запускать агент от root «для
#     простоты». Первый запуск от root создаёт cache/ и файл лога от root
#     (0755/0644), после чего сервис не может писать кеш ("Permission
#     denied") и тихо теряет файловый лог (проверено). Если так уже
#     случилось:
#       chown -R flat-service:flat-group /opt/flat/flat-check /var/log/flat/flat-check
