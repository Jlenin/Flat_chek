# Сессионный лог-файл сборщика/health-check (flat_check_2.log) — генерируется
# при каждом запуске скрипта, перезаписывается, в репозитории не нужен.
*.log

# Архивы, которые создаёт -log -on/-off при запуске скрипта из чекаута репозитория.
[0-9][0-9][0-9][0-9].[0-9][0-9].[0-9][0-9]_*.tar.gz

# Рабочий кеш flat_check_agent.sh (каталог cache/ рядом со скриптом) —
# генерируется при запуске, в репозитории не нужен.
agent/cache/
