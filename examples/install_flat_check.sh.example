#!/bin/bash
# Скелет установщика агента flat_check на ноде продукта.
# НЕ production-ready: без set -e в критичных местах, без rpm/deb.
# Цель — показать шаги: бинарь → conf → cron → проверка push.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC_CHECK="${SRC_CHECK:-$SCRIPT_DIR/flat_check.sh}"
INSTALL_BIN="${INSTALL_BIN:-/usr/local/bin/flat_check}"
CONF_DIR="${CONF_DIR:-/etc/flat}"
CONF_FILE="${CONF_FILE:-$CONF_DIR/flat_check.conf}"
LOG_DIR="${LOG_DIR:-/var/log/flat}"
CRON_FILE="${CRON_FILE:-/etc/cron.d/flat-check}"

PUSH_URL="${PUSH_URL:-}"
PUSH_TOKEN="${PUSH_TOKEN:-}"
HOST_ID="${HOST_ID:-$(hostname -s 2>/dev/null || hostname)}"
CRON_SPEC="${CRON_SPEC:-*/5 * * * *}"

die() { echo "ERROR: $*" >&2; exit 1; }
info() { echo "[INFO] $*"; }

[[ "$(id -u)" -eq 0 ]] || die "нужен root"
[[ -f "$SRC_CHECK" ]] || die "не найден $SRC_CHECK"

info "1) установка бинаря → $INSTALL_BIN"
install -m 0755 "$SRC_CHECK" "$INSTALL_BIN"

info "2) каталоги $CONF_DIR, $LOG_DIR"
install -d -m 0755 "$CONF_DIR" "$LOG_DIR"

if [[ ! -f "$CONF_FILE" ]]; then
    info "3) создаём $CONF_FILE"
    if [[ -f "$SCRIPT_DIR/examples/flat_check.conf.example" ]]; then
        cp "$SCRIPT_DIR/examples/flat_check.conf.example" "$CONF_FILE"
    else
        cat > "$CONF_FILE" <<EOF
PUSH_URL="${PUSH_URL}"
PUSH_TOKEN="${PUSH_TOKEN}"
HOST_ID="${HOST_ID}"
PACKAGES=""
PUSH_CONNECT_TIMEOUT=5
PUSH_MAX_TIME=30
PUSH_RETRIES=2
EOF
    fi
    # подставить значения из env, если передали
    if [[ -n "$PUSH_URL" ]]; then
        sed -i "s|^PUSH_URL=.*|PUSH_URL=\"${PUSH_URL}\"|" "$CONF_FILE"
    fi
    if [[ -n "$PUSH_TOKEN" ]]; then
        sed -i "s|^PUSH_TOKEN=.*|PUSH_TOKEN=\"${PUSH_TOKEN}\"|" "$CONF_FILE"
    fi
    sed -i "s|^HOST_ID=.*|HOST_ID=\"${HOST_ID}\"|" "$CONF_FILE"
    chmod 0640 "$CONF_FILE"
else
    info "3) $CONF_FILE уже есть — не трогаем"
fi

info "4) cron → $CRON_FILE"
cat > "$CRON_FILE" <<EOF
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

${CRON_SPEC} root ${INSTALL_BIN} --config ${CONF_FILE} --json --push >>${LOG_DIR}/flat_check_push.log 2>&1
EOF
chmod 0644 "$CRON_FILE"

info "5) пробный прогон (human)"
"$INSTALL_BIN" -v || true
# Когда появится --json:
# "$INSTALL_BIN" --config "$CONF_FILE" --json | head -c 200

info "готово."
info "  бинарь:  $INSTALL_BIN"
info "  конфиг:  $CONF_FILE"
info "  cron:    $CRON_FILE"
info "  лог:     $LOG_DIR/flat_check_push.log"
info "Дальше: прописать PUSH_URL/PUSH_TOKEN в конфиге и дождаться тика cron,"
info "либо вручную: $INSTALL_BIN --config $CONF_FILE --json --push"
