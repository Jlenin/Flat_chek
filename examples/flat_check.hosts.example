# /etc/flat/flat_check.hosts
# Опционально: карта для режима координатора (bastion + SSH).
# Основной путь в Partner — агент на каждой ноде, этот файл не обязателен.
#
# Формат: <пакет_или_роль>  <user@host>
# Комментарии и пустые строки игнорируются.

fss-server     root@10.0.1.5
fss-mediasrv   root@10.0.1.6
fss-srclient   root@10.0.1.5
mariadb        root@10.0.1.10
