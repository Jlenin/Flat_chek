# /etc/flat/flat_check.conf
# Конфиг агента на ноде продукта.

# --- идентификация снимка (обязательные поля в JSON) -------------------------
# Логический id хоста в инвентаре стенда / UI
HOST_ID="ss-n1"

# IP, с которого нода «представляется» (если пусто — первый non-lo IPv4)
HOST_IP="10.0.1.5"

# Имя сервиса/роли ноды по CI/CD (см. examples/service_names.example.md)
# Примеры: fss-backend, fps-backend, fss-server, sbc-backend, …
SERVICE_NAME="fss-backend"

# --- что проверять на ЭТОЙ машине --------------------------------------------
# Пусто = авто: все установленные пакеты из PKG_PRODUCT
PACKAGES=""
# PRODUCT="SoftSwitch"

# --- куда пушить (несколько приёмников) --------------------------------------
# Список через пробел или запятую. Каждый URL: http:// или https://
# Один и тот же JSON уходит на ВСЕ указанные endpoints (Partner, другие продукты).
PUSH_URLS="https://partner.example.local/api/v1/health/ingest http://fps-admin.example.local:8054/api/v1/health/ingest"

# Устаревший алиас (один URL) — поддерживается для совместимости:
# PUSH_URL="https://partner.example.local/api/v1/health/ingest"

# Токен(ы). Варианты:
#  1) один общий токен на все URL
PUSH_TOKEN="CHANGE_ME_SHARED_TOKEN"
#  2) либо per-URL (порядок = порядку PUSH_URLS), через пробел/запятую:
# PUSH_TOKENS="token-for-partner, token-for-fps"

# Заголовок авторизации (как договоритесь с бэками продуктов)
# Authorization: Bearer <token>   ИЛИ   X-Flat-Check-Token: <token>
PUSH_AUTH_HEADER="Authorization: Bearer"

# TLS: для https с корпоративным CA можно указать
# CURL_CA_BUNDLE=/etc/ssl/certs/ca-flat.pem
# PUSH_INSECURE=0

PUSH_CONNECT_TIMEOUT=5
PUSH_MAX_TIME=30
PUSH_RETRIES=2

# Параллельные воркеры проверки пакетов
# JOBS=4
