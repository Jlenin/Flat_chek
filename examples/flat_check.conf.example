# /etc/flat/flat_check.conf
# Конфиг агента на НОДЕ продукта (не координатора).

# Куда слать снимок (Partner ingest). Пусто = только локальный --json / stdout.
PUSH_URL="https://partner.example.local/api/v1/health/ingest"

# Токен / ключ стенда (Bearer или X-Api-Key — как договоритесь с backend).
PUSH_TOKEN="CHANGE_ME"

# Идентификатор хоста в UI / инвентаре стенда.
HOST_ID="ss-n1"

# Необязательно: явный адрес (иначе hostname -I / hostname -f).
# HOST_ADDR="10.0.1.5"

# Что проверять на ЭТОЙ машине.
# Пусто = авто: все пакеты из PKG_PRODUCT, которые установлены локально.
PACKAGES=""
# Альтернатива: ограничить продуктом
# PRODUCT="SoftSwitch"

# Таймауты push
PUSH_CONNECT_TIMEOUT=5
PUSH_MAX_TIME=30
PUSH_RETRIES=2

# Параллельные воркеры проверки пакетов (как -j)
# JOBS=4
